# Copy to .env (or set as system env vars / NSSM AppEnvironmentExtra on Windows)
WEBMANAGER_ROOT=D:\webmanager
PORT=8088

# CHANGE THESE before production
# JWT_SECRET: if left unset, a random secret is generated once into
# <ROOT>/data/jwt.secret (mode 0600). Set it explicitly to share one secret
# across instances. There is no hardcoded fallback.
JWT_SECRET=
ADMIN_USER=admin
ADMIN_PASS=change-me-on-first-login

# Cross-origin browser access. Empty (default) = none: the panel is same-origin
# and API clients (ML share puller, fleet hub) are server-side, so no CORS is
# needed. Comma-separated origins only if you really serve the UI elsewhere.
# WM_CORS_ORIGINS=https://panel.example.com

# nginx (Windows). Defaults to <ROOT>\nginx\nginx.exe
# NGINX_EXE=D:\webmanager\nginx\nginx.exe
# NGINX_PREFIX=D:\webmanager\nginx

# git (must be on PATH, or set absolute path)
# GIT_EXE=git
